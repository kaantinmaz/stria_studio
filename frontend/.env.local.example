# --- Local development ---
# Shared Laravel backend base URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8002

# Public site URL (canonical, sitemap, OpenGraph). Defaults to production.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Production (striastudio.com.tr) ---
# NEXT_PUBLIC_API_URL=https://admin.striastudio.com.tr
# NEXT_PUBLIC_SITE_URL=https://striastudio.com.tr

# --- Ölçümleme (varsayılanlar lib/site.ts içinde; burası yalnızca override) ---
# GA4 ölçüm kimliği. Boş bırakılırsa etiket hiç basılmaz (yerelde ölçüm kapalı).
# NEXT_PUBLIC_GA_ID=G-VHC49MXP5N
# Google Ads dönüşüm kimliği; hesap açılınca doldurulur.
# NEXT_PUBLIC_ADS_ID=AW-XXXXXXXXX
