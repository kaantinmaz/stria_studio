# Shared Laravel backend base URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8002

# Microsite slug — must match a key in backend/config/microsites.php.
NEXT_PUBLIC_SITE=mikroblading-ankara

# Public site URL (used for canonical, sitemap, OpenGraph).
NEXT_PUBLIC_SITE_URL=https://mikrobladingankara.com

