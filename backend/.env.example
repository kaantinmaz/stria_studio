APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OWNER_EMAIL=owner@striastudio.com
OWNER_PASSWORD=change-me-now
FRONTEND_URL=http://127.0.0.1:3001

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Write API (POST/DELETE /api/admin/posts) bearer token. Unset = endpoints
# disabled (401). Generate: openssl rand -hex 32
# ADMIN_API_TOKEN=

# Google Ads betiği (marketing/…/scripts/ads-daily-report.js) bu token'la
# POST /api/admin/ads/ingest'e yazar. Betik Ads arayüzünde açıkta durduğu için
# blog yazma token'ından AYRI olmalı. Generate: openssl rand -hex 32
# ADS_INGEST_TOKEN=

# `php artisan reviews:sync-google` bu anahtarla Google Places API (New)
# üzerinden işletmenin GERÇEK puanını çeker. Anahtar boşsa komut açıklayıcı
# hatayla döner. https://console.cloud.google.com > Places API (New)
# GOOGLE_PLACES_API_KEY=

# `php artisan instagram:sync` bu değerlerle Instagram Graph API üzerinden
# Business/Creator hesabının son gönderilerini çeker. Token uzun ömürlü access
# token, USER_ID ise IG kullanıcı kimliğidir; boşsa komut açıklayıcı hatayla
# döner. https://developers.facebook.com > Instagram Graph API
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# INSTAGRAM_LIMIT=12

# CORS: comma-separated origins allowed to call /api/* from the browser.
# Unset → config/cors.php defaults to the production domains. Dev: set to *
# CORS_ALLOWED_ORIGINS=*

# --- Production (admin.striastudio.com.tr) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://admin.striastudio.com.tr   # storage/cover image URLs derive from this
# SESSION_SECURE_COOKIE=true                 # Filament login over https
# FRONTEND_URL=https://striastudio.com.tr
