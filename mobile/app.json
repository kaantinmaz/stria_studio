{
  "expo": {
    "name": "Stria Studio",
    "slug": "stria-studio",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "striastudio",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.striastudio.app",
      "supportsTablet": false,
      "buildNumber": "1"
    },
    "android": {
      "package": "com.striastudio.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "backgroundColor": "#fbf4f1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
